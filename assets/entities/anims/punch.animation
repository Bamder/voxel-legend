# animation clip: bones are named channels; keys are local TRS from rest.
# unknown records are ignored by the parser and written back as-is.
# Right-arm punch overlay. Frame 10 is the hit (fist forward). Shoulder stays put
# so a walk cycle cannot twist the jab. Rx only.
name punch
fps 20.000
length 20
loop 0
rig player
bone hip parent - pivot 0.0000 0.8800 0.0000
bone abs parent hip pivot 0.0000 1.0600 0.0000
bone chest parent abs pivot 0.0000 1.2900 0.0000
bone neck parent chest pivot 0.0000 1.4100 0.0000
bone head parent neck pivot 0.0000 1.4400 0.0000
bone arm_r_shoulder parent chest pivot -0.2800 1.4200 0.0000
bone arm_r_upper parent arm_r_shoulder pivot -0.2800 1.3000 0.0000
bone arm_r_fore parent arm_r_upper pivot -0.2800 1.0600 0.0000
bone arm_r_hand parent arm_r_fore pivot -0.2800 0.8600 0.0000
bone arm_l_shoulder parent chest pivot 0.2800 1.4200 0.0000
bone arm_l_upper parent arm_l_shoulder pivot 0.2800 1.3000 0.0000
bone arm_l_fore parent arm_l_upper pivot 0.2800 1.0600 0.0000
bone arm_l_hand parent arm_l_fore pivot 0.2800 0.8600 0.0000
bone leg_l_thigh parent hip pivot -0.1200 0.8000 0.0000
bone leg_l_shin parent leg_l_thigh pivot -0.1200 0.4000 0.0000
bone leg_l_foot parent leg_l_shin pivot -0.1200 0.0800 0.0000
bone leg_r_thigh parent hip pivot 0.1200 0.8000 0.0000
bone leg_r_shin parent leg_r_thigh pivot 0.1200 0.4000 0.0000
bone leg_r_foot parent leg_r_shin pivot 0.1200 0.0800 0.0000
key 0 arm_l_shoulder 0.00000 0.00000 0.00000 0.00000 0.00000 0.00000
key 0 arm_l_hand 0.00000 0.00000 0.00000 0.00000 0.00000 0.00000
key 0 arm_l_upper 0.00000 0.00000 0.00000 0.00000 0.00000 0.00000
key 3 arm_l_upper 0.00000 0.00000 0.00000 -0.30000 0.00000 0.00000
key 8 arm_l_upper 0.00000 0.00000 0.00000 -0.50000 0.00000 0.00000
key 10 arm_l_upper 0.00000 0.00000 0.00000 -1.25000 0.00000 0.00000
key 13 arm_l_upper 0.00000 0.00000 0.00000 -0.55000 0.00000 0.00000
key 19 arm_l_upper 0.00000 0.00000 0.00000 0.00000 0.00000 0.00000
key 0 arm_l_fore 0.00000 0.00000 0.00000 0.00000 0.00000 0.00000
key 3 arm_l_fore 0.00000 0.00000 0.00000 -2.20000 0.00000 0.00000
key 8 arm_l_fore 0.00000 0.00000 0.00000 -2.35000 0.00000 0.00000
key 10 arm_l_fore 0.00000 0.00000 0.00000 -0.12000 0.00000 0.00000
key 13 arm_l_fore 0.00000 0.00000 0.00000 -0.20000 0.00000 0.00000
key 19 arm_l_fore 0.00000 0.00000 0.00000 0.00000 0.00000 0.00000
