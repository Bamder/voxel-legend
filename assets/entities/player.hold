# hold bind: model skeleton <-> action clip <-> item
# item/clip may be * (any). More specific rows win.
# bone is usually arm_r_palm / arm_l_palm (child of the hand).
# grip = model-space point on the bone; offset/rot are bone-local.
rig player
hold item * clip * side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item * clip * side left bone arm_l_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item hand_axe clip * side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.77077 0.00247 -3.11695 scale 0.4800
hold item hand_pick clip * side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item hand_pick clip mine_down side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item hand_pick clip mine_up side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item hand_pick clip pick_raise side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item hand_pick clip two_hand_ready side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item hand_shovel clip * side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item shears clip * side right bone arm_r_palm grip 0.5000 0.2200 0.5000 offset 0.00000 -0.02000 0.04000 rot 1.57080 0.00000 0.00000 scale 0.4800
hold item guide_book clip * side right bone arm_r_palm grip 0.1900 0.5000 0.5000 offset 0.00000 -0.01500 0.03000 rot 0.20000 0.00000 -0.32000 scale 0.5200
hold item guide_book clip * side left bone arm_l_palm grip 0.1900 0.5000 0.5000 offset 0.00000 -0.01500 0.03000 rot 0.20000 0.00000 0.32000 scale 0.5200
hold item arcane_fireball clip * side right bone arm_r_palm grip 0.5000 0.5000 0.1750 offset 0.00000 -0.01500 0.03500 rot 0.15000 0.00000 -0.26000 scale 0.5000
hold item arcane_fireball clip * side left bone arm_l_palm grip 0.5000 0.5000 0.1750 offset 0.00000 -0.01500 0.03500 rot 0.15000 0.00000 0.26000 scale 0.5000
hold item arcane_freeze clip * side right bone arm_r_palm grip 0.5000 0.5000 0.1750 offset 0.00000 -0.01500 0.03500 rot 0.15000 0.00000 -0.26000 scale 0.5000
hold item arcane_freeze clip * side left bone arm_l_palm grip 0.5000 0.5000 0.1750 offset 0.00000 -0.01500 0.03500 rot 0.15000 0.00000 0.26000 scale 0.5000
hold item arcane_heal clip * side right bone arm_r_palm grip 0.5000 0.5000 0.1750 offset 0.00000 -0.01500 0.03500 rot 0.15000 0.00000 -0.26000 scale 0.5000
hold item arcane_heal clip * side left bone arm_l_palm grip 0.5000 0.5000 0.1750 offset 0.00000 -0.01500 0.03500 rot 0.15000 0.00000 0.26000 scale 0.5000
hold item * clip hold_block side right bone chest grip 0.5000 0.5000 0.5000 offset 0.00000 -0.13000 0.34000 rot 0.00000 0.00000 0.00000 scale 0.3600
hold item * clip hold_block side left bone chest grip 0.5000 0.5000 0.5000 offset 0.00000 -0.13000 0.34000 rot 0.00000 0.00000 0.00000 scale 0.3600
